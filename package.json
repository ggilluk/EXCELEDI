{
  "name": "edifact-excel-transformer",
  "version": "1.0.0",
  "description": "Spec-driven transformer between UN/EDIFACT container messages (BAPLIE, COPRAR, CODECO, ...) and Excel workbooks",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "edifact-excel": "dist/cli.js"
  },
  "files": [
    "dist",
    "specs"
  ],
  "scripts": {
    "build:specs": "tsx scripts/build-specs.ts",
    "build": "npm run build:specs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:specs",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "build:web": "npm run build:specs && tsx scripts/build-web.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
